{
  "name": "holocad",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w @holocad/web\" \"npm run dev -w @holocad/api\"",
    "build": "npm run build -w @holocad/web",
    "test": "npm test -w @holocad/api",
    "db:migrate": "npm run db:migrate -w @holocad/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.9"
  }
}
