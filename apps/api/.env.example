# Copy to apps/api/.env and fill in. .env is gitignored.
API_PORT=3001

# Your local Postgres user and password. Create the databases first:
#   createdb holocad && createdb holocad_test
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/holocad
# Used only by `npm test`; the migration test wipes this database.
DATABASE_URL_TEST=postgres://USER:PASSWORD@localhost:5432/holocad_test

# Uploads and converted GLBs. Relative paths are from the repo root.
STORAGE_DIR=storage
CONVERTER_URL=http://127.0.0.1:8001
MAX_UPLOAD_MB=200
# A STEP conversion still running after this many minutes is marked failed.
CONVERSION_TIMEOUT_MIN=10
